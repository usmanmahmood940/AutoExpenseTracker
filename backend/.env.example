# Copy to .env for local development. Never commit .env.

# local | dev | staging | prod
ENVIRONMENT=local
SERVICE_NAME=novaspend-api
LOG_LEVEL=INFO
# Unset follows ENVIRONMENT: JSON everywhere except local.
# LOG_JSON=true

# Accepts postgresql:// or postgres:// too; the asyncpg driver is added for you.
DATABASE_URL=postgresql+asyncpg://novaspend:novaspend@localhost:5432/novaspend_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Supabase (Cloud Run / remote migrate only). Prefer the *session pooler* URI
# (aws-0-<region>.pooler.supabase.com) — direct db.<ref>.supabase.co is often
# IPv6-only. If the password contains @ # etc, URL-encode them (%40 for @).
# SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Firebase ---
FIREBASE_PROJECT_ID=auto-expense-tracker-2026
# Path to a service account JSON. Leave unset on Cloud Run (uses the runtime
# service account) or after `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Web API key for server-side password sign-in. Required from Phase B.
# FIREBASE_WEB_API_KEY=
# Costs one Admin lookup per request, but honours password-change revocation.
VERIFY_TOKEN_REVOKED=true

# --- Phase B: auth OTP + email ---
# HMAC key for OTP codes. Unset = a random key per process (fine for local dev;
# outstanding OTPs just stop verifying across a restart).
# OTP_HASH_SECRET=
# Unset = OTP codes are logged instead of emailed (no Resend account needed
# for local dev / tests). Set both to actually send mail.
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=NovaSpend <noreply@your-verified-domain.com>

# --- Phase D: ingest + workers ---
# Gemini key for SMS/email parse. Unset = ingest records needs_parse locally.
# GEMINI_API_KEY=
# Optional extra header for POST /ingest. If set, Shortcuts must send
# X-Ingest-Secret with the same value. Unset = X-User-Id only (Function parity).
# INGEST_SHARED_SECRET=
# Shared secret for POST /internal/jobs/*. Unset is allowed only when
# ENVIRONMENT=local (tests / make run). Set before deploying workers.
# CRON_SECRET=

# Comma-separated. Empty disables CORS entirely (fine for a mobile-only client).
CORS_ORIGINS=

# Serve /docs and /openapi.json. Consider false in prod.
DOCS_ENABLED=true
