rules_version = '2';

// ===============================================================
// Assumed Data Model (cold backup only)
// ===============================================================
//
// After FastAPI + Postgres cutover (docs/backend-migration-plan.md
// §6 step 12 / §8.3), Firestore is retained as a backup. Existing
// collections (users, transactions, raw_ingestions, categories,
// merchantCategoryOverrides, monthlySummaries, auth ephemeral docs,
// etc.) are not read or written by NovaSpend clients.
//
// Firebase Admin SDK (migrate scripts) bypasses these rules.
// Data is kept until the retention window (30–90 days), then
// collections may be deleted. Auth + FCM are unchanged.
//
// Client access is deny-all. There are no allowed queries, so no
// per-collection validators: every create/update/delete/get/list
// from a client SDK is rejected. isAuthenticated / isOwner / uid
// helpers are omitted because no path grants access.
//
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
